# Build context exclusions.
#
# The Dockerfile does COPY . /opt/cyraven/src and then R CMD INSTALL, so
# everything R CMD INSTALL reads must stay: DESCRIPTION, NAMESPACE, R/, man/,
# inst/, tests/, vignettes/, LICENSE. Everything below is either not needed to
# build the package or is large enough to make the context slow to transfer.

# Version control and CI
.git
.gitignore
.github

# Benchmark inputs and outputs. Tens of megabytes of FCS and generated results,
# none of which the package needs in order to install.
benchmark

# Local run artefacts
results
results_*
demo
.checkdir
*.Rcheck
*.tar.gz

# Rendered documentation site, regenerated by pkgdown
docs

# Source artwork. man/figures/ holds the copies the package actually uses; this
# directory is the high-resolution originals.
logo

# Editor and session state
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj

# Assistant skill definition. Documentation for humans and agents, not an input
# to the build.
.claude
